{
  "name": "website-cloner",
  "productName": "Website Cloner",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first, MIT-licensed desktop website archiver.",
  "main": "desktop/main.js",
  "scripts": {"start": "electron .", "serve": "node serve.js", "dev": "electron .", "test": "node --test test/*.test.js", "build": "electron-builder"},
  "license": "MIT",
  "dependencies": {"jszip": "^3.10.1"},
  "devDependencies": {"electron": "^38.1.0", "electron-builder": "^26.0.12"},
  "build": {"appId": "com.websitecloner.desktop", "productName": "Website Cloner", "artifactName": "Website-Cloner-${version}-${os}-${arch}.${ext}", "icon": "build/icon.svg", "files": ["desktop/**/*", "README.md", "LICENSE", "build/**/*"], "win": {"target": "nsis"}, "mac": {"target": "dmg"}, "linux": {"target": ["AppImage", "deb"]}}
}
